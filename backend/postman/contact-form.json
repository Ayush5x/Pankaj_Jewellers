{
  "info": {
    "_postman_id": "jewellery-contact-form-api",
    "name": "Jewellery Contact Form API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Submit Enquiry",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Vishal Barde\",\n  \"phone\": \"+919876543210\",\n  \"email\": \"vishal@example.com\",\n  \"interest\": \"Engagement ring\",\n  \"consultationType\": \"WhatsApp\",\n  \"message\": \"I need a custom diamond engagement ring.\"\n}"
        },
        "url": "{{baseUrl}}/api/contact"
      }
    },
    {
      "name": "Get Enquiries",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/contact"
      }
    }
  ]
}